#!/usr/bin/env php
<?php

declare(strict_types=1);

use Go\Yii3\GoAopBridge\Tests\Support\TestApplication;

/*
 * Console entry script of the fixture application, laid out like the one of the yiisoft/app template.
 * GOAOP_TEST_ENTRY_LINE=0 skips the entry line, so the kernel is initialized by the bootstrap config group.
 */

require_once dirname(__DIR__, 3) . '/vendor/autoload.php';

if (getenv('GOAOP_TEST_ENTRY_LINE') !== '0') {
    TestApplication::initKernel();
}

TestApplication::runner()->run();
